# Supabase — find these at: supabase.com → your project → Settings → API

# Used server-side (edge functions)
SUPABASE_URL=                      # Project URL e.g. https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=          # anon/public key
SUPABASE_PROJECT_ID=               # Reference ID (the xxxx part of your URL)

# Used client-side (Vite exposes VITE_ prefixed vars to the browser)
VITE_SUPABASE_URL=                 # same value as SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY=     # same value as SUPABASE_PUBLISHABLE_KEY (anon key)
VITE_SUPABASE_PROJECT_ID=          # same value as SUPABASE_PROJECT_ID

# WARNING: Never add SUPABASE_SERVICE_ROLE_KEY here.
# It bypasses RLS and must only be set inside Supabase edge function secrets.
